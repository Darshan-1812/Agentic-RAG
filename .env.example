# TypeSafe AI Jev System 1 Control Plane API Key
JEV_API_KEY=jev_preview_demo_key
JEV_API_BASE_URL=https://api.typesafe.ai/v1

# CalibRAG Governance SLA Policy Default (economy | balanced | strict)
CALIBRAG_DEFAULT_SLA_POLICY=balanced

# Mid-Pipeline Confidence Gate Thresholds
CALIBRAG_TAU_ESCALATE_BALANCED=0.65
CALIBRAG_TAU_ABSTAIN_BALANCED=0.50

CALIBRAG_TAU_ESCALATE_ECONOMY=0.35
CALIBRAG_TAU_ABSTAIN_ECONOMY=0.30

CALIBRAG_TAU_NOUL_STRICT=0.88

# Member 2: PostgreSQL 17 + pgvector + ParadeDB pg_search
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/calibrag

# Member 3: FastMCP Connectors & LLM API Keys
POSTGRES_ERP_READONLY_URI=postgresql://readonly:erp_pass@erp-db.company.com:5432/production_erp
GITHUB_TOKEN=ghp_example_token_for_issue_tracking
OPENAI_API_KEY=sk-demo-key-for-cascaded-models
ANTHROPIC_API_KEY=sk-ant-demo-key

# Member 4: Frontend & Benchmarks
NEXT_PUBLIC_CALIBRAG_API_URL=http://localhost:8000/v1
BENCHMARK_SAMPLE_SIZE=300

# Logging & Environment
LOG_LEVEL=INFO
ENVIRONMENT=development
