# TypeSafe AI Jev System 1 Control Plane API Key
JEV_API_KEY=jev_preview_demo_key
JEV_API_BASE_URL=https://api.typesafe.ai/v1

# Governance SLA Policy Default (economy | balanced | strict)
ACR_DEFAULT_SLA_POLICY=balanced

# Mid-Pipeline Confidence Gate Thresholds
ACR_TAU_ESCALATE_BALANCED=0.65
ACR_TAU_ABSTAIN_BALANCED=0.50

ACR_TAU_ESCALATE_ECONOMY=0.35
ACR_TAU_ABSTAIN_ECONOMY=0.30

ACR_TAU_NOUL_STRICT=0.88

# Logging & Environment
LOG_LEVEL=INFO
ENVIRONMENT=development
