# Member 2 ingestion worker configuration.
# Copy to .env (ignored by git) or export these variables.

# asyncpg accepts both forms; the +asyncpg suffix is normalized automatically.
RETRIEVAL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/calibrag
RETRIEVAL_DB_POOL_MIN_SIZE=1
RETRIEVAL_DB_POOL_MAX_SIZE=10
RETRIEVAL_DB_COMMAND_TIMEOUT=30
RETRIEVAL_DB_STATEMENT_CACHE_SIZE=100

# Keep uploaded source files outside the web root.
RETRIEVAL_STORAGE_ROOT=./retrieval/storage
RETRIEVAL_MAX_UPLOAD_BYTES=104857600

RETRIEVAL_CHUNK_TARGET_CHARS=1800
RETRIEVAL_CHUNK_MAX_CHARS=2600
RETRIEVAL_CHUNK_OVERLAP_CHARS=200

RETRIEVAL_DOCLING_OCR=true
RETRIEVAL_DOCLING_INCLUDE_PAGE_FURNITURE=false

# Phase 4 LightRAG graph storage and extraction runtime.
RETRIEVAL_GRAPH_STORAGE_ROOT=./retrieval/storage/graph
RETRIEVAL_GRAPH_KV_STORAGE=JsonKVStorage
RETRIEVAL_GRAPH_VECTOR_STORAGE=NanoVectorDBStorage
RETRIEVAL_GRAPH_GRAPH_STORAGE=NetworkXStorage
RETRIEVAL_GRAPH_DOC_STATUS_STORAGE=JsonDocStatusStorage
RETRIEVAL_GRAPH_LLM_MODEL=gpt-4o-mini
RETRIEVAL_GRAPH_LLM_BASE_URL=
# Prefer RETRIEVAL_GRAPH_LLM_API_KEY; GROQ_API_KEY and OPENAI_API_KEY are fallbacks.
RETRIEVAL_GRAPH_LLM_API_KEY=
# GROQ_API_KEY=
RETRIEVAL_GRAPH_LLM_TIMEOUT=60
RETRIEVAL_GRAPH_LLM_MAX_ASYNC=4
RETRIEVAL_GRAPH_MAX_NODES=1000
RETRIEVAL_GRAPH_TRAVERSAL_MAX_NODES=200

# Docker Compose defaults for the ParadeDB PostgreSQL 17 service.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=calibrag
POSTGRES_PORT=5432
